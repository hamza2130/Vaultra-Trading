# Local development: `npx supabase start` prints these values.
# Production (Vercel): use your Supabase project's Settings > API values instead,
# and set the same three variables in the Vercel project settings.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# SERVER-ONLY. Bypasses every security rule, so it must never be exposed to the browser
# (never prefix it with NEXT_PUBLIC_). Used for admin actions, money functions, uploads.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
