# Supabase — local dev values are printed by `npx supabase start`.
# For a real project, get these from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only — never expose this to the browser. Used for admin actions
# (writing balance_ledger/activity_log, uploading admin proof, etc).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
